<?xml version="1.0" encoding="UTF-8" ?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <listener>
        <listener-class>hu.pte.mik.prog4.zh2_2026.listener.ServletContextListener</listener-class>
    </listener>

    <servlet>
        <servlet-name>CarListServlet</servlet-name>
        <servlet-class>hu.pte.mik.prog4.zh2_2026.servlet.CarListServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CarSaveServlet</servlet-name>
        <servlet-class>hu.pte.mik.prog4.zh2_2026.servlet.CarSaveServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>JerseyRESTService</servlet-name>
        <servlet-class>org.glassfish.jersey.servlet.ServletContainer</servlet-class>
        <init-param>
            <param-name>jersey.config.server.provider.packages</param-name>
            <param-value>hu.pte.mik.prog4.zh2_2026.api.controller</param-value>
        </init-param>
        <init-param>
            <param-name>jersey.config.server.provider.classnames</param-name>
            <param-value>org.glassfish.jersey.jackson.JacksonFeature</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <servlet-mapping>
        <servlet-name>CarListServlet</servlet-name>
        <url-pattern>/car-list</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CarSaveServlet</servlet-name>
        <url-pattern>/car-save</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>JerseyRESTService</servlet-name>
        <url-pattern>/api/*</url-pattern>
    </servlet-mapping>

    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Dealer Area</web-resource-name>
            <url-pattern>/car-save</url-pattern>
            <url-pattern>/carSave.jsp</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>dealer</role-name>
        </auth-constraint>
    </security-constraint>

    <security-constraint>
        <web-resource-collection>
            <web-resource-name>User Area</web-resource-name>
            <url-pattern>/car-list</url-pattern>
            <url-pattern>/carList.jsp</url-pattern>
            <url-pattern>/api/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>user</role-name>
        </auth-constraint>
    </security-constraint>

    <login-config>
        <auth-method>FORM</auth-method>
        <realm-name>CarApp</realm-name>
        <form-login-config>
            <form-login-page>/login.html</form-login-page>
            <form-error-page>/login_failed.html</form-error-page>
        </form-login-config>
    </login-config>

    <security-role>
        <role-name>user</role-name>
    </security-role>
    <security-role>
        <role-name>dealer</role-name>
    </security-role>

</web-app>