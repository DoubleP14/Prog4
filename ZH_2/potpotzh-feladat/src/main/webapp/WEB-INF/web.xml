<?xml version="1.0" encoding="UTF-8" ?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <servlet>
        <servlet-name>CompanyListServlet</servlet-name>
        <servlet-class>hu.pte.mik.prog4.potpotzh.servlet.CompanyListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CompanyListServlet</servlet-name>
        <url-pattern>/company-list</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SaveCompanyServlet</servlet-name>
        <servlet-class>hu.pte.mik.prog4.potpotzh.servlet.SaveCompanyServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SaveCompanyServlet</servlet-name>
        <url-pattern>/company-save</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogOutServlet</servlet-name>
        <servlet-class>hu.pte.mik.prog4.potpotzh.servlet.LogOutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogOutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>Jersey REST Service</servlet-name>
        <servlet-class>org.glassfish.jersey.servlet.ServletContainer</servlet-class>
        <init-param>
            <param-name>jersey.config.server.provider.packages</param-name>
            <param-value>hu.pte.mik.prog4.potpotzh.api.controller</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>Jersey REST Service</servlet-name>
        <url-pattern>/api/*</url-pattern>
    </servlet-mapping>

    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Protected Area</web-resource-name>
            <url-pattern>/company-list</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>viewer</role-name>
        </auth-constraint>
    </security-constraint>

    <login-config>
        <auth-method>FORM</auth-method>
        <realm-name>potpotzhRealm</realm-name>
        <form-login-config>
            <form-login-page>/login.html</form-login-page>
            <form-error-page>/login_failed.html</form-error-page>
        </form-login-config>
    </login-config>

    <security-role>
        <role-name>viewer</role-name>
    </security-role>

</web-app>