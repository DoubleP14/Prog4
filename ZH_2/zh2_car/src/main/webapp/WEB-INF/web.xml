<?xml version="1.0" encoding="UTF-8" ?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <servlet>
        <servlet-name>CarListServlet</servlet-name>
        <servlet-class>hu.pte.mik.prog4.zh2.servlet.CarListServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>SaveCarServlet</servlet-name>
        <servlet-class>hu.pte.mik.prog4.zh2.servlet.SaveCarServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>CarListServlet</servlet-name>
        <url-pattern>/car-list</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SaveCarServlet</servlet-name>
        <url-pattern>/save-car</url-pattern>
    </servlet-mapping>

    <listener>
        <description>ProjectServletContextListener</description>
        <listener-class>hu.pte.mik.prog4.zh2.listener.ProjectServletContextListener</listener-class>
    </listener>

    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Public Access</web-resource-name>
            <url-pattern>/</url-pattern>
            <url-pattern>/index.jsp</url-pattern>
            <url-pattern>/login.jsp</url-pattern>
            <url-pattern>/login_failed.html</url-pattern>
            <url-pattern>/register.jsp</url-pattern>
            <url-pattern>/register</url-pattern>
            <url-pattern>/ws/*</url-pattern>
        </web-resource-collection>
    </security-constraint>

    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Creator Access</web-resource-name>
            <url-pattern>/save-car</url-pattern>
            <url-pattern>/saveCar.jsp</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>creator</role-name>
        </auth-constraint>
    </security-constraint>

    <security-constraint>
        <web-resource-collection>
            <web-resource-name>User Access</web-resource-name>
            <url-pattern>/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>user</role-name>
        </auth-constraint>
    </security-constraint>

    <login-config>
        <auth-method>FORM</auth-method>
        <realm-name>jaas-realm</realm-name>
        <form-login-config>
            <form-login-page>/login.jsp</form-login-page>
            <form-error-page>/login_failed.html</form-error-page>
        </form-login-config>
    </login-config>

    <security-role>
        <role-name>user</role-name>
    </security-role>
    <security-role>
        <role-name>creator</role-name>
    </security-role>

</web-app>